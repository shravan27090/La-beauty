---
export interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  items?: FAQItem[];
}

const defaultFAQs: FAQItem[] = [
  {
    question: "What makes a Russian Dry Manicure different from a traditional manicure?",
    answer:
      "Unlike traditional water-soak manicures where the natural nail swells and causes polish to chip prematurely, the Russian dry manicure uses medical-grade diamond e-file bits on completely dry cuticles. This allows micron-precision detailing around the eponychium and enables polish application deep under the proximal fold, ensuring immaculate regrowth lasting 3 to 4 weeks.",
  },
  {
    question: "How do you sterilize and sanitize your manicure and pedicure instruments?",
    answer:
      "We strictly adhere to medical hospital-grade sterilization protocols. All stainless steel nippers, pushers, and carbide bits undergo an initial ultrasonic enzymatic bath, followed by vacuum steam autoclave sterilization at 134°C. Each sterile kit is vacuum-sealed in an individual pouch with a chemical sterilization indicator and unsealed only in front of you.",
  },
  {
    question: "Is your cooling laser hair reduction safe for Indian skin tones, and is it painful?",
    answer:
      "Yes, absolutely. Our clinic utilizes advanced triple-wavelength diode laser technology (755nm Alexandrite, 808nm Diode, and 1064nm Nd:YAG) integrated with a continuous sub-zero sapphire crystal contact cooling tip (-5°C). The sub-zero tip pre-cools and numbs the epidermis before and during every pulse, making sessions virtually pain-free and clinically safe across Fitzpatrick skin types I through VI.",
  },
  {
    question: "How long do gel extensions and gel overlays last, and do they damage natural nails?",
    answer:
      "Our European rubber base gel overlays last 3 to 4 weeks, while sculpted hard gel or acrylic extensions last 4 to 5 weeks with proper home care. Because we never use electric files aggressively on your natural nail plate and use non-acidic primer bonds, your natural nails remain strong, flexible, and healthy beneath the enhancement.",
  },
  {
    question: "Do I need to book in advance, or do you accept walk-in appointments?",
    answer:
      "To preserve a calm, private sanctuary without rushed appointments or crowded waiting areas, prior reservations are strongly recommended. We welcome walk-in guests whenever our master stylists have open slots. You can quickly reserve a slot via WhatsApp at +91 720 410 3767 or through our online booking page.",
  },
  {
    question: "Are your nail formulations vegan, non-toxic, and cruelty-free?",
    answer:
      "Yes. We exclusively import premium European 9-free and 10-free vegan gel formulations that are devoid of harmful toxins like formaldehyde, toluene, dibutyl phthalate (DBP), and camphor. Our skincare rituals feature hypoallergenic dermo-cosmetics formulated with organic enzymes and marine extracts.",
  },
  {
    question: "Where is La Beauté located in Manipal, and is parking available?",
    answer:
      "We are conveniently situated at Greenview Apartments, State Highway 65, near Trends in Hayagreeva Nagar, Manipal, Udupi (Karnataka 576104). Ample dedicated client parking is available directly at the salon entrance.",
  },
];

const { items = defaultFAQs } = Astro.props;
---

<div class="faq-accordion-container w-full divide-y divide-[#ebebdf] border-y border-[#ebebdf]">
  {
    items.map((item, index) => (
      <div class="faq-item py-1">
        <button
          type="button"
          class="faq-trigger w-full py-5 flex items-center justify-between text-left transition-colors group focus:outline-none"
          aria-expanded="false"
          aria-controls={`faq-answer-${index}`}
          id={`faq-question-${index}`}
        >
          <span class="font-serif text-lg sm:text-xl font-bold text-lb-gray-dark group-hover:text-black transition-colors pr-6">
            {item.question}
          </span>
          <span class="faq-icon-wrapper flex-shrink-0 w-8 h-8 rounded-full bg-[#f0f0e6] flex items-center justify-center text-lb-gray group-hover:bg-lb-gray group-hover:text-white transition-all duration-300">
            <svg
              class="faq-chevron w-4 h-4 transition-transform duration-300 ease-out"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </span>
        </button>

        <div
          id={`faq-answer-${index}`}
          role="region"
          aria-labelledby={`faq-question-${index}`}
          class="faq-content grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-in-out"
        >
          <div class="overflow-hidden">
            <p class="text-sm sm:text-base text-lb-gray font-light leading-relaxed pr-6 pb-6 pt-1">
              {item.answer}
            </p>
          </div>
        </div>
      </div>
    ))
  }
</div>

<script>
  function initFAQAccordions() {
    const containers = document.querySelectorAll('.faq-accordion-container');

    containers.forEach((container) => {
      if (container.hasAttribute('data-faq-initialized')) return;
      container.setAttribute('data-faq-initialized', 'true');

      const items = container.querySelectorAll('.faq-item');

      items.forEach((item) => {
        const trigger = item.querySelector('.faq-trigger') as HTMLButtonElement | null;
        const content = item.querySelector('.faq-content') as HTMLElement | null;
        const chevron = item.querySelector('.faq-chevron') as HTMLElement | null;

        if (!trigger || !content) return;

        trigger.addEventListener('click', () => {
          const isExpanded = trigger.getAttribute('aria-expanded') === 'true';

          // Optional: close other open items in the same container for clean accordion behavior
          items.forEach((otherItem) => {
            if (otherItem === item) return;
            const otherTrigger = otherItem.querySelector('.faq-trigger') as HTMLButtonElement | null;
            const otherContent = otherItem.querySelector('.faq-content') as HTMLElement | null;
            const otherChevron = otherItem.querySelector('.faq-chevron') as HTMLElement | null;

            if (otherTrigger && otherContent) {
              otherTrigger.setAttribute('aria-expanded', 'false');
              otherContent.classList.remove('grid-rows-[1fr]');
              otherContent.classList.add('grid-rows-[0fr]');
              otherChevron?.classList.remove('rotate-180');
            }
          });

          // Toggle current item
          if (isExpanded) {
            trigger.setAttribute('aria-expanded', 'false');
            content.classList.remove('grid-rows-[1fr]');
            content.classList.add('grid-rows-[0fr]');
            chevron?.classList.remove('rotate-180');
          } else {
            trigger.setAttribute('aria-expanded', 'true');
            content.classList.remove('grid-rows-[0fr]');
            content.classList.add('grid-rows-[1fr]');
            chevron?.classList.add('rotate-180');
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFAQAccordions);
  } else {
    initFAQAccordions();
  }
  document.addEventListener('astro:page-load', initFAQAccordions);
</script>
