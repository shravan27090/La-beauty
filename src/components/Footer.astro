---
const currentYear = new Date().getFullYear();
---

<footer class="bg-lb-gray-dark text-[#ecece2] pt-16 pb-12 border-t border-black/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8 pb-12 border-b border-white/10">
      
      <!-- Brand & Philosophy Column -->
      <div class="space-y-4">
        <a href="/" class="block">
          <img
            src="/La-Beaute-F9F7F1-BG-3d3d3d-full-Trans-e1743959280716-extractpics.webp"
            alt="La Beauté Logo"
            class="h-12 w-auto aspect-[348/256] object-contain brightness-0 invert opacity-90"
            width="348"
            height="256"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="text-sm text-gray-300 leading-relaxed font-light">
          Where Parisian minimalism meets master-grade beauty artistry. Dedicated to precision nail care, advanced laser aesthetics, and transformative skincare in Udupi & Manipal.
        </p>
        
        <!-- Google Review Badge with Inter numbers -->
        <div class="inline-flex items-center space-x-3 bg-white/5 border border-white/10 px-3.5 py-2 rounded-xl">
          <div class="flex items-center text-amber-400 text-sm">
            <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
          </div>
          <div class="text-xs text-gray-300 font-number">
            <span class="font-semibold text-white">4.9 / 5</span> (23 Google Reviews)
          </div>
        </div>
      </div>

      <!-- Quick Navigation -->
      <div>
        <h3 class="font-serif text-base text-white font-semibold mb-4 tracking-wide">
          Explore
        </h3>
        <ul class="space-y-2.5 text-sm text-gray-300">
          <li>
            <a href="/" class="hover:text-white transition-colors flex items-center space-x-2">
              <span class="text-xs text-gray-400">&bull;</span>
              <span>Home</span>
            </a>
          </li>
          <li>
            <a href="/services" class="hover:text-white transition-colors flex items-center space-x-2">
              <span class="text-xs text-gray-400">&bull;</span>
              <span>Services & Treatments</span>
            </a>
          </li>
          <li>
            <a href="/portfolio" class="hover:text-white transition-colors flex items-center space-x-2">
              <span class="text-xs text-gray-400">&bull;</span>
              <span>Nail Art Portfolio</span>
            </a>
          </li>
          <li>
            <a href="/about" class="hover:text-white transition-colors flex items-center space-x-2">
              <span class="text-xs text-gray-400">&bull;</span>
              <span>Our Story & Master Stylists</span>
            </a>
          </li>
          <li>
            <a href="/contact" class="hover:text-white transition-colors flex items-center space-x-2">
              <span class="text-xs text-gray-400">&bull;</span>
              <span>Contact & Appointments</span>
            </a>
          </li>
          <li>
            <a href="/faq" class="hover:text-white transition-colors flex items-center space-x-2">
              <span class="text-xs text-gray-400">&bull;</span>
              <span>Frequently Asked Questions</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Hours & Appointments -->
      <div>
        <h3 class="font-serif text-base text-white font-semibold mb-4 tracking-wide">
          Salon Hours
        </h3>
        <div class="space-y-2 text-sm text-gray-300">
          <div class="flex justify-between py-1 border-b border-white/5">
            <span class="text-gray-400">Monday – Saturday</span>
            <span class="font-medium text-white font-number">10:00 AM – 8:00 PM</span>
          </div>
          <div class="flex justify-between py-1 border-b border-white/5">
            <span class="text-gray-400">Sunday</span>
            <span class="font-medium text-white font-number">10:00 AM – 8:00 PM</span>
          </div>
          <div class="pt-3">
            <p class="text-xs text-gray-400">
              * Prior appointments recommended to ensure dedicated attention and sterilized suite preparation.
            </p>
          </div>
        </div>
      </div>

      <!-- Location & Contact Details -->
      <div>
        <h3 class="font-serif text-base text-white font-semibold mb-4 tracking-wide">
          Visit Us
        </h3>
        <div class="space-y-3 text-sm text-gray-300">
          <p class="flex items-start space-x-2.5">
            <svg class="w-5 h-5 text-gray-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span class="leading-relaxed">
              Greenview Apartments, SH 65, near Trends, Manipal, Hayagreeva Nagar, Udupi, Karnataka 576104
            </span>
          </p>

          <p class="flex items-center space-x-2.5">
            <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z"></path>
            </svg>
            <a href="tel:+917204103767" class="hover:text-white transition-colors font-medium text-white font-number">
              +91 720 410 3767
            </a>
          </p>

          <p class="flex items-center space-x-2.5">
            <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path>
              <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
            </svg>
            <a href="mailto:info@la-beaute.in" class="hover:text-white transition-colors">
              info@la-beaute.in
            </a>
          </p>

          <!-- Social Icon -->
          <div class="pt-2">
            <a
              href="https://www.instagram.com/labeautemanipal/?hl=en"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center space-x-2 text-xs font-semibold px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 hover:text-white transition-all duration-200 border border-white/10 text-gray-200"
            >
              <svg class="w-4 h-4 text-gray-300" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
              <span>Follow @labeautemanipal</span>
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright with Exact Address -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-gray-400 gap-4">
      <p>&copy; {currentYear} La Beauté. Greenview Apartments, SH 65, near Trends, Manipal, Hayagreeva Nagar, Udupi, Karnataka 576104.</p>
      <div class="flex items-center space-x-1.5 font-sans text-xs">
        <span>Built by</span>
        <a
          href="https://shravan.space/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-200 hover:text-white underline underline-offset-4 decoration-white/30 hover:decoration-white transition-colors font-medium"
        >
          Shravan
        </a>
      </div>
    </div>
  </div>
</footer>
