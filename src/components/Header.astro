---
import Button from "./ui/Button.astro";

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  { label: "Home", href: "/" },
  { label: "Services", href: "/services" },
  { label: "Portfolio", href: "/portfolio" },
  { label: "About", href: "/about" },
  { label: "Contact", href: "/contact" },
];

const isActive = (href: string) => {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
};
---

<header
  id="main-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-[#f6f6ee] border-b border-[#ecece2]"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div
      class="flex items-center justify-between h-20 transition-all duration-300"
      id="nav-container"
    >
      <!-- Brand Logo + Text Lockup: La Beauté -->
      <a
        href="/"
        class="flex items-center space-x-3 group focus:outline-none py-1"
        aria-label="La Beauté Home"
      >
        <img
          src="/La-Beaute-logo.png"
          alt="La Beauté Monogram Emblem"
          class="h-10 sm:h-12 w-auto object-contain transition-transform duration-300 group-hover:scale-102"
          width="48"
          height="48"
          loading="eager"
          decoding="async"
        />
        <div class="flex flex-col">
          <span
            class="font-serif text-xl sm:text-2xl font-bold tracking-wider text-lb-gray-dark group-hover:text-black transition-colors leading-none"
          >
            La Beauté
          </span>
          <span
            class="text-[9px] uppercase tracking-[0.25em] text-lb-gray font-semibold font-sans mt-0.5"
          >
            Manipal
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav
        class="hidden md:flex items-center space-x-1 lg:space-x-2"
        aria-label="Main Navigation"
      >
        {
          navItems.map((item) => {
            const active = isActive(item.href);
            return (
              <a
                href={item.href}
                class={`px-4 py-2 text-xs uppercase tracking-wider font-semibold rounded-full transition-all duration-200 ${
                  active
                    ? "text-white bg-lb-gray shadow-sm"
                    : "text-lb-gray hover:text-lb-gray-dark hover:bg-lb-gray/20"
                }`}
              >
                {item.label}
              </a>
            );
          })
        }
      </nav>

      <!-- Right Header Actions: Balanced Call & WhatsApp Icon Logos -->
      <div class="hidden sm:flex items-center space-x-3">
        <!-- Call Icon Button -->
        <a
          href="tel:+917204103767"
          aria-label="Call +91 720 410 3767"
          title="Call +91 720 410 3767"
          class="w-10 h-10 rounded-full border border-lb-gray/30 bg-white/90 hover:bg-lb-gray/20 text-lb-gray flex items-center justify-center transition-all duration-200 shadow-sm hover:scale-105"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path
              d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z"
            ></path>
          </svg>
        </a>

        <!-- WhatsApp Icon Button (Balanced Size) -->
        <a
          href="https://wa.me/917204103767?text=Hello%20La%20Beaut%C3%A9,%20I%20would%20like%20to%20inquire%20about%20booking%20an%20appointment"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Chat with La Beauté on WhatsApp"
          title="WhatsApp +91 720 410 3767"
          class="w-10 h-10 rounded-full border border-[#25D366]/40 bg-[#25D366]/10 hover:bg-[#25D366]/20 text-[#128C7E] flex items-center justify-center transition-all duration-200 shadow-sm hover:scale-105"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
            ></path>
          </svg>
        </a>

        <!-- Secondary Outline Booking Button with Primary/40 lighter hover -->
        <a
          href="/contact"
          class="border border-lb-gray text-lb-gray hover:bg-lb-gray/40 hover:text-lb-gray-dark px-5 py-2 rounded-full text-xs uppercase tracking-wider font-semibold transition-all duration-200"
        >
          Book Now
        </a>
      </div>

      <!-- Mobile Right Section (Call, WhatsApp & Hamburger) -->
      <div class="flex items-center space-x-2 md:hidden">
        <!-- Call Icon Logo -->
        <a
          href="tel:+917204103767"
          aria-label="Call +91 720 410 3767"
          class="w-9 h-9 rounded-full border border-lb-gray/30 bg-white text-lb-gray flex items-center justify-center"
        >
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
            <path
              d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z"
            ></path>
          </svg>
        </a>

        <!-- WhatsApp Icon Logo (Balanced Size) -->
        <a
          href="https://wa.me/917204103767?text=Hello%20La%20Beaut%C3%A9,%20I%20would%20like%20to%20inquire%20about%20booking%20an%20appointment"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="WhatsApp"
          class="w-9 h-9 rounded-full border border-[#25D366]/40 bg-[#25D366]/10 text-[#128C7E] flex items-center justify-center"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
            ></path>
          </svg>
        </a>

        <!-- Hamburger Button -->
        <button
          type="button"
          id="mobile-menu-btn"
          class="p-2 rounded-lg text-lb-gray hover:text-lb-gray-dark hover:bg-black/5 focus:outline-none transition-colors"
          aria-expanded="false"
          aria-label="Toggle mobile menu"
        >
          <svg
            id="hamburger-icon"
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg
            id="close-icon"
            class="w-6 h-6 hidden"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-[#ebebdf] bg-[#f6f6ee]/98 backdrop-blur-md px-6 pt-4 pb-8 space-y-4 shadow-lg animate-fade-in"
  >
    <nav class="flex flex-col space-y-2">
      {
        navItems.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              class={`px-4 py-3 rounded-xl text-xs uppercase tracking-wider font-semibold transition-colors ${
                active
                  ? "bg-lb-gray text-white"
                  : "text-lb-gray hover:bg-lb-gray/20 hover:text-lb-gray-dark"
              }`}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>
    <div class="pt-4 border-t border-[#ebebdf] space-y-3">
      <Button href="/contact" variant="outline" class="w-full">
        Book Now
      </Button>
    </div>
  </div>
</header>

<script>
  // Dynamic header transition on scroll
  const header = document.getElementById("main-header");
  const navContainer = document.getElementById("nav-container");

  const handleScroll = () => {
    if (window.scrollY > 20) {
      header?.classList.add("nav-scrolled");
      navContainer?.classList.remove("h-20");
      navContainer?.classList.add("h-16");
    } else {
      header?.classList.remove("nav-scrolled");
      navContainer?.classList.add("h-20");
      navContainer?.classList.remove("h-16");
    }
  };

  window.addEventListener("scroll", handleScroll, { passive: true });
  handleScroll();

  // Mobile menu toggle
  const menuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const hamburgerIcon = document.getElementById("hamburger-icon");
  const closeIcon = document.getElementById("close-icon");

  menuBtn?.addEventListener("click", () => {
    const isExpanded = menuBtn.getAttribute("aria-expanded") === "true";
    menuBtn.setAttribute("aria-expanded", String(!isExpanded));
    mobileMenu?.classList.toggle("hidden");
    hamburgerIcon?.classList.toggle("hidden");
    closeIcon?.classList.toggle("hidden");
  });
</script>
