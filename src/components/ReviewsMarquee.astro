---
export interface Review {
  author: string;
  service: string;
  quote: string;
  rating: number;
  date: string;
}

const reviews: Review[] = [
  {
    author: "Deepika Kamath",
    service: "Russian Manicure & Chrome Nails",
    quote:
      "Without exaggeration, the cleanest and most precise manicure I have ever received in Karnataka. The Russian technique is immaculate — my cuticles stayed pristine for 4 whole weeks!",
    rating: 5,
    date: "2 weeks ago",
  },
  {
    author: "Dr. Shruti Nayak",
    service: "Painless Laser Hair Reduction",
    quote:
      "As a physician in Manipal, hygiene is my highest priority. La Beauté’s autoclaved instrumentation and cooling laser technology impressed me thoroughly. Completely painless experience.",
    rating: 5,
    date: "1 month ago",
  },
  {
    author: "Rhea Fernandes",
    service: "Bridal Nail Art & Spa Pedicure",
    quote:
      "Booked my entire bridal entourage here. Fatima and her team treated us like royalty. The bespoke champagne chrome nail extensions matched my lehenga flawlessly!",
    rating: 5,
    date: "3 weeks ago",
  },
  {
    author: "Meghana Bhat",
    service: "Gel Overlay & Cuticle Realignment",
    quote:
      "I used to have brittle peeling nails from household chores. Their European rubber base treatment completely restored my natural nail strength. Such gentle, attentive care.",
    rating: 5,
    date: "1 week ago",
  },
  {
    author: "Ayesha Siddiqua",
    service: "Parisian Radiance Glow Facial",
    quote:
      "The French facial sculpting massage relieved so much tension in my jaw and neck. My skin had an authentic dewy glow for days without any redness or irritation.",
    rating: 5,
    date: "2 weeks ago",
  },
  {
    author: "Sneha Poojary",
    service: "Deluxe Volcanic Spa Pedicure",
    quote:
      "The hot stone foot ritual and eucalyptus soak is pure therapy. The suite is serene, quiet, and spotless. It felt like a luxury sanctuary away from the city.",
    rating: 5,
    date: "3 weeks ago",
  },
  {
    author: "Ananya Rao",
    service: "Cat-Eye Velvet Gel Extensions",
    quote:
      "The magnetic velvet finish gets compliments wherever I go! The attention to detail, shape symmetry, and sterile pouch opening gives complete peace of mind.",
    rating: 5,
    date: "4 weeks ago",
  },
];

// Triplicate reviews to enable seamless bidirectional infinite looping
const allReviews = [...reviews, ...reviews, ...reviews];
---

<div
  class="relative w-full overflow-hidden group"
  id="reviews-carousel-section"
>
  <!-- Controls for Manual Scroll -->
  <div
    class="flex items-center justify-between mb-8 px-4 sm:px-6 max-w-7xl mx-auto"
  >
    <div class="flex items-center space-x-2 font-number">
      <div class="flex text-amber-400 text-sm">
        <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
      </div>
      <span class="font-bold hidden md:flex text-lb-gray-dark text-sm"
        >4.9 / 5 Rating</span
      >
      <span class="text-xs text-lb-gray font-sans">(23+ Google Reviews)</span>
    </div>

    <!-- Arrow navigation buttons -->
    <div class="flex items-center space-x-2">
      <button
        type="button"
        id="prev-review-btn"
        aria-label="Previous review"
        class="w-9 h-9 rounded-full border border-lb-gray/30 bg-white text-lb-gray hover:bg-lb-gray/30 hover:text-lb-gray-dark flex items-center justify-center transition-colors shadow-sm cursor-pointer"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>

      <button
        type="button"
        id="next-review-btn"
        aria-label="Next review"
        class="w-9 h-9 rounded-full border border-lb-gray/30 bg-white text-lb-gray hover:bg-lb-gray/30 hover:text-lb-gray-dark flex items-center justify-center transition-colors shadow-sm cursor-pointer"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Horizontal Scroll Track with Auto-Animation & Infinite Loop -->
  <div
    id="reviews-track"
    class="flex gap-6 overflow-x-auto scrollbar-none px-4 sm:px-6 lg:px-8 py-4 cursor-grab active:cursor-grabbing select-none"
    style="scrollbar-width: none; -ms-overflow-style: none;"
  >
    {
      allReviews.map((r) => (
        <div class="min-w-[290px] sm:min-w-[360px] max-w-[380px] flex-shrink-0 bg-white rounded-3xl p-7 border border-[#ebebdf] shadow-sm hover:shadow-luxury-hover transition-all duration-300 flex flex-col justify-between h-[280px]">
          <div>
            <div class="flex items-center justify-between mb-3">
              <div class="flex text-amber-400 text-sm">
                <>
                  <span>★</span>
                  <span>★</span>
                  <span>★</span>
                  <span>★</span>
                  <span>★</span>
                </>
              </div>
              <div class="flex items-center space-x-1 text-[11px] font-medium text-lb-gray-light bg-[#fafaf6] px-2.5 py-0.5 rounded-full border border-[#ecece2]">
                <svg
                  class="w-3 h-3 text-blue-500"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path
                    d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                    fill="#4285F4"
                  />
                  <path
                    d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                    fill="#34A853"
                  />
                  <path
                    d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"
                    fill="#FBBC05"
                  />
                  <path
                    d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"
                    fill="#EA4335"
                  />
                </svg>
                <span>Verified</span>
              </div>
            </div>

            <p class="text-xs sm:text-sm text-lb-gray leading-relaxed font-light italic line-clamp-4">
              "{r.quote}"
            </p>
          </div>

          <div class="pt-3 border-t border-[#f2f2eb] flex items-center justify-between">
            <div>
              <h4 class="font-serif font-bold text-sm text-lb-gray-dark">
                {r.author}
              </h4>
              <p class="text-[11px] text-lb-gray font-medium">{r.service}</p>
            </div>
            <span class="text-[10px] text-lb-gray-light font-number">
              {r.date}
            </span>
          </div>
        </div>
      ))
    }
  </div>

  <!-- Subtle Hint -->
  <p class="text-center text-[11px] text-lb-gray-light mt-4 font-sans">
    Hover or touch to pause &bull; Swipe or scroll horizontally to browse all
    reviews
  </p>
</div>

<script>
  const track = document.getElementById("reviews-track") as HTMLDivElement | null;
  const prevBtn = document.getElementById("prev-review-btn");
  const nextBtn = document.getElementById("next-review-btn");

  let isPaused = false;
  let isDragging = false;
  let startX = 0;
  let scrollLeftStart = 0;
  let scrollSpeed = 0.8; // px per tick
  let animationId: number;

  function getSetWidth(): number {
    if (!track) return 0;
    return track.scrollWidth / 3;
  }

  // Seamless wrap function that works in both forward and backward directions
  function checkInfiniteLoop() {
    if (!track) return;
    const setWidth = getSetWidth();
    if (setWidth <= 0) return;

    // Scrolled forward past the 2nd set -> shift seamlessly back by 1 set
    if (track.scrollLeft >= setWidth * 2) {
      track.scrollLeft -= setWidth;
    }
    // Scrolled backward before the start of the 2nd set -> shift seamlessly forward by 1 set
    else if (track.scrollLeft <= setWidth * 0.1) {
      track.scrollLeft += setWidth;
    }
  }

  // Initialize track position in the middle set
  function initPosition() {
    if (!track) return;
    const setWidth = getSetWidth();
    if (setWidth > 0) {
      track.scrollLeft = setWidth;
    }
  }

  // Continuous auto-scroll loop (60fps)
  function autoScroll() {
    if (!isPaused && !isDragging && track) {
      track.scrollLeft += scrollSpeed;
      checkInfiniteLoop();
    }
    animationId = requestAnimationFrame(autoScroll);
  }

  // Start auto scroll and initial position
  requestAnimationFrame(() => {
    initPosition();
    animationId = requestAnimationFrame(autoScroll);
  });

  // Re-check on window resize
  window.addEventListener("resize", () => {
    checkInfiniteLoop();
  });

  // Mouse Drag on Desktop
  track?.addEventListener("mousedown", (e) => {
    isDragging = true;
    isPaused = true;
    startX = e.pageX - track.offsetLeft;
    scrollLeftStart = track.scrollLeft;
  });

  window.addEventListener("mouseup", () => {
    if (isDragging) {
      isDragging = false;
      checkInfiniteLoop();
      setTimeout(() => {
        isPaused = false;
      }, 1500);
    }
  });

  window.addEventListener("mousemove", (e) => {
    if (!isDragging || !track) return;
    e.preventDefault();
    const x = e.pageX - track.offsetLeft;
    const walk = (x - startX) * 1.4;
    track.scrollLeft = scrollLeftStart - walk;
    checkInfiniteLoop();
  });

  // Touch Swipe on Mobile
  track?.addEventListener(
    "touchstart",
    () => {
      isPaused = true;
    },
    { passive: true },
  );

  track?.addEventListener(
    "touchend",
    () => {
      checkInfiniteLoop();
      setTimeout(() => {
        isPaused = false;
      }, 2000);
    },
    { passive: true },
  );

  // Manual scroll event (trackpad or wheel)
  let scrollDebounce: any;
  track?.addEventListener(
    "scroll",
    () => {
      if (isPaused) {
        clearTimeout(scrollDebounce);
        scrollDebounce = setTimeout(() => {
          checkInfiniteLoop();
        }, 50);
      }
    },
    { passive: true },
  );

  // Pause on hover
  track?.addEventListener("mouseenter", () => {
    isPaused = true;
  });

  track?.addEventListener("mouseleave", () => {
    if (!isDragging) {
      isPaused = false;
    }
  });

  // Arrow navigation buttons
  prevBtn?.addEventListener("click", () => {
    isPaused = true;
    track?.scrollBy({ left: -360, behavior: "smooth" });
    setTimeout(() => {
      checkInfiniteLoop();
      isPaused = false;
    }, 700);
  });

  nextBtn?.addEventListener("click", () => {
    isPaused = true;
    track?.scrollBy({ left: 360, behavior: "smooth" });
    setTimeout(() => {
      checkInfiniteLoop();
      isPaused = false;
    }, 700);
  });
</script>
