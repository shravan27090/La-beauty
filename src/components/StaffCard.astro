---
interface Props {
  name: string;
  role: string;
  experience: string;
  specialties: string[];
  image: string;
  bio: string;
}

const { name, role, experience, specialties, image, bio } = Astro.props;
---

<div class="bg-white rounded-3xl overflow-hidden border border-[#ebebdf] shadow-sm hover:shadow-luxury-hover transition-all duration-500 flex flex-col h-full group hover:-translate-y-1 w-full max-w-sm sm:max-w-none mx-auto">
  <!-- Profile Image Container -->
  <div class="relative aspect-[4/5] w-full overflow-hidden bg-[#ebebdf]">
    <img
      src={image}
      alt={name}
      loading="lazy"
      class="w-full h-full object-cover object-[center_15%] transition-transform duration-700 ease-out group-hover:scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent opacity-40"></div>
    
    <!-- Experience Badge -->
    <span class="absolute top-4 left-4 text-[11px] font-semibold tracking-wider text-white bg-lb-gray-dark/85 backdrop-blur-md px-3.5 py-1 rounded-full border border-white/20 shadow-xs font-sans">
      {experience}
    </span>
  </div>

  <!-- Profile Details in Card Body -->
  <div class="p-6 flex flex-col flex-grow justify-between bg-white">
    <div>
      <div class="mb-3">
        <h3 class="font-serif text-2xl font-bold text-lb-gray-dark tracking-tight group-hover:text-black transition-colors">
          {name}
        </h3>
        <p class="text-xs uppercase tracking-wider font-semibold text-amber-700 mt-1 font-sans">
          {role}
        </p>
      </div>

      <p class="text-xs sm:text-sm text-lb-gray leading-relaxed font-light mb-6">
        {bio}
      </p>
    </div>

    <div class="pt-4 border-t border-[#f2f2eb]">
      <span class="text-[11px] uppercase tracking-wider font-semibold text-lb-gray-light block mb-2 font-sans">
        Signature Specialties
      </span>
      <div class="flex flex-wrap gap-1.5">
        {specialties.map((specialty) => (
          <span class="text-[11px] font-medium bg-[#fafaf6] text-lb-gray-dark px-2.5 py-1 rounded-lg border border-[#ecece2] font-sans">
            {specialty}
          </span>
        ))}
      </div>
    </div>
  </div>
</div>
