---
interface Props {
  id?: string;
  name?: string;
  placeholder?: string;
  required?: boolean;
  class?: string;
}

const {
  id = "date",
  name = "date",
  placeholder = "Pick an appointment date",
  required = false,
  class: className = "",
} = Astro.props;
---

<div
  class={`relative w-full custom-datepicker ${className}`}
  id={`${id}-wrapper`}
>
  <!-- Hidden input for standard form submission -->
  <input type="hidden" id={id} name={name} value="" required={required} />

  <!-- Popover Trigger Button (Matches shadcn Popover Trigger) -->
  <button
    type="button"
    id={`${id}-trigger`}
    class="flex h-12 w-full items-center justify-between rounded-xl border border-[#ebebdf] bg-[#fafaf6] px-4 py-3 text-sm text-lb-gray-dark shadow-sm transition-all duration-200 hover:border-lb-gray/70 focus:bg-white focus:border-lb-gray-dark focus:outline-none focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-lb-gray-dark cursor-pointer font-sans text-left"
    aria-expanded="false"
    aria-haspopup="dialog"
  >
    <div class="flex items-center gap-2.5 truncate">
      <svg
        class="w-4 h-4 text-lb-gray shrink-0 opacity-70"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
        <line x1="16" y1="2" x2="16" y2="6"></line>
        <line x1="8" y1="2" x2="8" y2="6"></line>
        <line x1="3" y1="10" x2="21" y2="10"></line>
      </svg>
      <span
        id={`${id}-display`}
        class="text-sm text-lb-gray-light/80 select-none"
      >
        {placeholder}
      </span>
    </div>

    <div class="flex items-center gap-1.5 shrink-0 ml-2">
      <!-- Clear button (hidden by default) -->
      <span
        id={`${id}-clear`}
        role="button"
        tabindex="0"
        title="Clear date"
        class="hidden p-1 rounded-full text-lb-gray hover:text-lb-gray-dark hover:bg-lb-gray/10 transition-colors cursor-pointer"
      >
        <svg
          class="w-3.5 h-3.5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </span>

      <svg
        class="w-4 h-4 text-lb-gray opacity-50 transition-transform duration-200"
        id={`${id}-chevron`}
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"
        ></path>
      </svg>
    </div>
  </button>

  <!-- Calendar Popover Content (Matches shadcn Calendar) -->
  <div
    id={`${id}-popover`}
    class="hidden absolute z-50 left-0 sm:left-auto sm:right-0 mt-2 w-full sm:w-[320px] rounded-2xl border border-[#ebebdf] bg-white shadow-2xl p-4 font-sans animate-fade-in"
    role="dialog"
    aria-label="Appointment Calendar"
  >
    <!-- Calendar Navigation & Dropdowns -->
    <div class="flex items-center justify-between gap-1 mb-3">
      <!-- Prev Month Button -->
      <button
        type="button"
        id={`${id}-prev-month`}
        aria-label="Previous month"
        class="h-8 w-8 rounded-lg border border-[#ebebdf] bg-white hover:bg-[#f6f6ee] text-lb-gray-dark flex items-center justify-center transition-colors cursor-pointer shadow-2xs"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>

      <!-- Month & Year Selectors (captionLayout="dropdown" style) -->
      <div class="flex items-center gap-1.5">
        <select
          id={`${id}-month-select`}
          class="h-8 px-2 py-0.5 text-xs font-semibold rounded-lg border border-[#ebebdf] bg-[#fafaf6] text-lb-gray-dark hover:border-lb-gray/70 focus:outline-none cursor-pointer"
        >
          <option value="0">January</option>
          <option value="1">February</option>
          <option value="2">March</option>
          <option value="3">April</option>
          <option value="4">May</option>
          <option value="5">June</option>
          <option value="6">July</option>
          <option value="7">August</option>
          <option value="8">September</option>
          <option value="9">October</option>
          <option value="10">November</option>
          <option value="11">December</option>
        </select>

        <select
          id={`${id}-year-select`}
          class="h-8 px-2 py-0.5 text-xs font-semibold rounded-lg border border-[#ebebdf] bg-[#fafaf6] text-lb-gray-dark hover:border-lb-gray/70 focus:outline-none cursor-pointer font-number"
        >
          <!-- Filled dynamically via JS -->
        </select>
      </div>

      <!-- Next Month Button -->
      <button
        type="button"
        id={`${id}-next-month`}
        aria-label="Next month"
        class="h-8 w-8 rounded-lg border border-[#ebebdf] bg-white hover:bg-[#f6f6ee] text-lb-gray-dark flex items-center justify-center transition-colors cursor-pointer shadow-2xs"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"
          ></path>
        </svg>
      </button>
    </div>

    <!-- Weekday Labels -->
    <div class="grid grid-cols-7 text-center mb-1.5">
      <span class="text-[11px] font-semibold text-lb-gray-light uppercase py-1"
        >Su</span
      >
      <span class="text-[11px] font-semibold text-lb-gray-light uppercase py-1"
        >Mo</span
      >
      <span class="text-[11px] font-semibold text-lb-gray-light uppercase py-1"
        >Tu</span
      >
      <span class="text-[11px] font-semibold text-lb-gray-light uppercase py-1"
        >We</span
      >
      <span class="text-[11px] font-semibold text-lb-gray-light uppercase py-1"
        >Th</span
      >
      <span class="text-[11px] font-semibold text-lb-gray-light uppercase py-1"
        >Fr</span
      >
      <span class="text-[11px] font-semibold text-lb-gray-light uppercase py-1"
        >Sa</span
      >
    </div>

    <!-- Days Grid -->
    <div id={`${id}-days-grid`} class="grid grid-cols-7 gap-1">
      <!-- Days populated dynamically by JS -->
    </div>

    <!-- Quick Footer: Today shortcut & Close -->
    <div
      class="flex items-center justify-between pt-3 mt-3 border-t border-[#f2f2eb] text-xs"
    >
      <button
        type="button"
        id={`${id}-today-btn`}
        class="text-xs font-semibold text-lb-gray hover:text-lb-gray-dark transition-colors cursor-pointer"
      >
        Today
      </button>
      <span class="text-[10px] text-lb-gray-light">
        Salon Open: 10am – 8pm
      </span>
    </div>
  </div>
</div>

<style>
  /* Day button styling */
  :global(.cal-day-btn) {
    height: 34px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.625rem;
    font-size: 0.8125rem;
    font-family:
      "Inter",
      system-ui,
      -apple-system,
      sans-serif;
    transition: all 0.15s ease;
    cursor: pointer;
  }

  :global(.cal-day-btn.is-disabled) {
    opacity: 0.22;
    cursor: not-allowed;
    text-decoration: line-through;
    pointer-events: none;
  }

  :global(.cal-day-btn.is-outside) {
    opacity: 0.25;
    pointer-events: none;
  }

  :global(.cal-day-btn.is-today:not(.is-selected)) {
    font-weight: 700;
    position: relative;
    background-color: #f2f2ea;
  }

  :global(.cal-day-btn.is-today:not(.is-selected)::after) {
    content: "";
    position: absolute;
    bottom: 3px;
    width: 4px;
    height: 4px;
    border-radius: 9999px;
    background-color: #2c2a2d;
  }

  :global(.cal-day-btn.is-selected) {
    background-color: #2c2a2d !important;
    color: #ffffff !important;
    font-weight: 600;
    box-shadow: 0 4px 10px rgba(44, 42, 45, 0.2);
    transform: scale(0.96);
  }

  :global(
    .cal-day-btn:not(.is-disabled):not(.is-outside):not(.is-selected):hover
  ) {
    background-color: #f0f0e6;
    color: #2c2a2d;
  }
</style>

<script define:vars={{ id, placeholder }}>
  const wrapper = document.getElementById(`${id}-wrapper`);
  const trigger = document.getElementById(`${id}-trigger`);
  const popover = document.getElementById(`${id}-popover`);
  const hiddenInput = document.getElementById(id);
  const displayEl = document.getElementById(`${id}-display`);
  const clearBtn = document.getElementById(`${id}-clear`);
  const chevron = document.getElementById(`${id}-chevron`);
  const prevBtn = document.getElementById(`${id}-prev-month`);
  const nextBtn = document.getElementById(`${id}-next-month`);
  const monthSelect = document.getElementById(`${id}-month-select`);
  const yearSelect = document.getElementById(`${id}-year-select`);
  const daysGrid = document.getElementById(`${id}-days-grid`);
  const todayBtn = document.getElementById(`${id}-today-btn`);

  // State
  const today = new Date();
  today.setHours(0, 0, 0, 0);

  let currentViewYear = today.getFullYear();
  let currentViewMonth = today.getMonth();
  let selectedDate = null;

  // Initialize year dropdown (current year up to current + 3 years)
  function initYearSelect() {
    yearSelect.innerHTML = "";
    const startYear = today.getFullYear();
    for (let y = startYear; y <= startYear + 3; y++) {
      const opt = document.createElement("option");
      opt.value = y.toString();
      opt.textContent = y.toString();
      yearSelect.appendChild(opt);
    }
  }

  function formatDate(d) {
    const options = {
      weekday: "short",
      month: "short",
      day: "numeric",
      year: "numeric",
    };
    return d.toLocaleDateString("en-US", options);
  }

  function formatISODate(d) {
    const year = d.getFullYear();
    const month = String(d.getMonth() + 1).padStart(2, "0");
    const day = String(d.getDate()).padStart(2, "0");
    return `${year}-${month}-${day}`;
  }

  function renderCalendar() {
    monthSelect.value = currentViewMonth.toString();
    yearSelect.value = currentViewYear.toString();
    daysGrid.innerHTML = "";

    const firstDayIndex = new Date(
      currentViewYear,
      currentViewMonth,
      1,
    ).getDay(); // 0 (Sun) - 6 (Sat)
    const daysInMonth = new Date(
      currentViewYear,
      currentViewMonth + 1,
      0,
    ).getDate();
    const daysInPrevMonth = new Date(
      currentViewYear,
      currentViewMonth,
      0,
    ).getDate();

    // Previous month padding days
    for (let i = firstDayIndex - 1; i >= 0; i--) {
      const dayNum = daysInPrevMonth - i;
      const btn = document.createElement("div");
      btn.className = "cal-day-btn is-outside";
      btn.textContent = dayNum.toString();
      daysGrid.appendChild(btn);
    }

    // Days in current month
    for (let d = 1; d <= daysInMonth; d++) {
      const dateObj = new Date(currentViewYear, currentViewMonth, d);
      dateObj.setHours(0, 0, 0, 0);

      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "cal-day-btn";
      btn.textContent = d.toString();

      // Check if past date
      if (dateObj < today) {
        btn.classList.add("is-disabled");
        btn.setAttribute("aria-disabled", "true");
      } else {
        // Today check
        if (dateObj.getTime() === today.getTime()) {
          btn.classList.add("is-today");
        }

        // Selected check
        if (selectedDate && dateObj.getTime() === selectedDate.getTime()) {
          btn.classList.add("is-selected");
        }

        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          selectDate(dateObj);
        });
      }

      daysGrid.appendChild(btn);
    }
  }

  function selectDate(date) {
    selectedDate = date;
    const isoString = formatISODate(date);
    hiddenInput.value = isoString;
    hiddenInput.dispatchEvent(new Event("change", { bubbles: true }));

    // Update display
    displayEl.textContent = formatDate(date);
    displayEl.classList.remove("text-lb-gray-light/80");
    displayEl.classList.add("text-lb-gray-dark", "font-medium");
    clearBtn.classList.remove("hidden");

    renderCalendar();
    togglePopover(false);
  }

  function clearDate() {
    selectedDate = null;
    hiddenInput.value = "";
    hiddenInput.dispatchEvent(new Event("change", { bubbles: true }));
    displayEl.textContent = placeholder;
    displayEl.classList.add("text-lb-gray-light/80");
    displayEl.classList.remove("text-lb-gray-dark", "font-medium");
    clearBtn.classList.add("hidden");
    renderCalendar();
  }

  function togglePopover(show) {
    if (show) {
      popover.classList.remove("hidden");
      trigger.setAttribute("aria-expanded", "true");
      chevron.classList.add("rotate-180");
      renderCalendar();
    } else {
      popover.classList.add("hidden");
      trigger.setAttribute("aria-expanded", "false");
      chevron.classList.remove("rotate-180");
    }
  }

  // Event Listeners
  trigger.addEventListener("click", (e) => {
    if (e.target.closest(`#${id}-clear`)) {
      clearDate();
      return;
    }
    const isHidden = popover.classList.contains("hidden");
    togglePopover(isHidden);
  });

  clearBtn.addEventListener("click", (e) => {
    e.stopPropagation();
    clearDate();
  });

  prevBtn.addEventListener("click", (e) => {
    e.stopPropagation();
    currentViewMonth--;
    if (currentViewMonth < 0) {
      currentViewMonth = 11;
      currentViewYear--;
    }
    renderCalendar();
  });

  nextBtn.addEventListener("click", (e) => {
    e.stopPropagation();
    currentViewMonth++;
    if (currentViewMonth > 11) {
      currentViewMonth = 0;
      currentViewYear++;
    }
    renderCalendar();
  });

  monthSelect.addEventListener("change", (e) => {
    currentViewMonth = parseInt(e.target.value, 10);
    renderCalendar();
  });

  yearSelect.addEventListener("change", (e) => {
    currentViewYear = parseInt(e.target.value, 10);
    renderCalendar();
  });

  todayBtn.addEventListener("click", (e) => {
    e.stopPropagation();
    selectDate(new Date(today));
  });

  // Close when clicking outside
  document.addEventListener("click", (e) => {
    if (!wrapper.contains(e.target)) {
      togglePopover(false);
    }
  });

  // Close on Escape
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !popover.classList.contains("hidden")) {
      togglePopover(false);
    }
  });

  initYearSelect();
  renderCalendar();
</script>
