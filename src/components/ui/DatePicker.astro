---
interface Props {
  id?: string;
  name?: string;
  placeholder?: string;
  required?: boolean;
  class?: string;
}

const {
  id = "date",
  name = "date",
  placeholder = "Pick an appointment date",
  required = false,
  class: className = "",
} = Astro.props;

const monthNames = [
  "January",
  "February",
  "March",
  "April",
  "May",
  "June",
  "July",
  "August",
  "September",
  "October",
  "November",
  "December",
];
---

<div
  class={`relative w-full custom-datepicker ${className}`}
  id={`${id}-wrapper`}
>
  <!-- Hidden input for standard form submission -->
  <input type="hidden" id={`${id}-input`} name={name} value="" required={required} />

  <!-- Popover Trigger Button (Matches shadcn Popover Trigger) -->
  <button
    type="button"
    id={`${id}-trigger`}
    class="flex h-12 w-full items-center justify-between rounded-xl border border-[#ebebdf] bg-[#fafaf6] px-4 py-3 text-sm text-lb-gray-dark shadow-sm transition-all duration-200 hover:border-lb-gray/70 focus:bg-white focus:border-lb-gray-dark focus:outline-none focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-lb-gray-dark cursor-pointer font-sans text-left"
    aria-expanded="false"
    aria-haspopup="dialog"
  >
    <div class="flex items-center truncate max-w-[calc(100%-28px)]">
      <span
        id={`${id}-display`}
        class="text-sm text-lb-gray-light/80 select-none truncate font-sans"
      >
        {placeholder}
      </span>
    </div>

    <div class="flex items-center shrink-0 ml-2">
      <svg
        class="w-4 h-4 text-lb-gray opacity-50 transition-transform duration-200"
        id={`${id}-chevron`}
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"
        ></path>
      </svg>
    </div>
  </button>

  <!-- Calendar Popover Content (Matches shadcn Calendar) -->
  <div
    id={`${id}-popover`}
    class="hidden absolute z-50 left-0 sm:left-auto sm:right-0 mt-2 w-full sm:w-[320px] rounded-2xl border border-[#ebebdf] bg-white shadow-2xl p-4 font-sans animate-fade-in"
    role="dialog"
    aria-label="Appointment Calendar"
  >
    <!-- Calendar Navigation & Month/Year Selectors (shadcn Select dropdown style) -->
    <div class="relative z-50 flex items-center justify-between gap-1 mb-3">
      <!-- Prev Month Button -->
      <button
        type="button"
        id={`${id}-prev-month`}
        aria-label="Previous month"
        class="h-8 w-8 rounded-lg border border-[#ebebdf] bg-white hover:bg-[#f6f6ee] text-lb-gray-dark flex items-center justify-center transition-colors cursor-pointer shadow-2xs shrink-0"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>

      <!-- Month & Year Selectors -->
      <div class="flex items-center gap-1.5">
        <!-- Month Dropdown -->
        <div class="relative z-50" id={`${id}-month-dropdown-wrapper`}>
          <button
            type="button"
            id={`${id}-month-btn`}
            aria-haspopup="listbox"
            aria-expanded="false"
            aria-label="Select month"
            class="h-8 px-2.5 py-1 text-xs font-semibold rounded-lg border border-[#ebebdf] bg-[#fafaf6] hover:bg-[#f6f6ee] text-lb-gray-dark flex items-center gap-1 cursor-pointer transition-colors shadow-2xs focus:outline-none focus:ring-1 focus:ring-lb-gray-dark"
          >
            <span id={`${id}-month-label`}>January</span>
            <svg
              class="w-3 h-3 text-lb-gray opacity-60 transition-transform duration-200 shrink-0"
              id={`${id}-month-chevron`}
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>

          <!-- Month Popover Menu -->
          <div
            id={`${id}-month-popover`}
            class="hidden absolute left-0 top-full mt-1.5 w-36 max-h-56 overflow-y-auto rounded-xl border border-[#ebebdf] bg-white shadow-2xl p-1 z-[9999] font-sans"
            style="background-color: #ffffff !important;"
            role="listbox"
          >
            {
              monthNames.map((name, idx) => (
                <div
                  class="cal-month-opt flex items-center justify-between px-2.5 py-1.5 rounded-lg text-xs text-lb-gray-dark hover:bg-[#f6f6ee] transition-colors cursor-pointer select-none font-sans"
                  data-month={idx}
                  role="option"
                >
                  <span class="truncate">{name}</span>
                  <svg
                    class="cal-month-check w-3 h-3 text-lb-gray-dark shrink-0 ml-1.5 hidden"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                  </svg>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Year Dropdown -->
        <div class="relative z-50" id={`${id}-year-dropdown-wrapper`}>
          <button
            type="button"
            id={`${id}-year-btn`}
            aria-haspopup="listbox"
            aria-expanded="false"
            aria-label="Select year"
            class="h-8 px-2.5 py-1 text-xs font-semibold rounded-lg border border-[#ebebdf] bg-[#fafaf6] hover:bg-[#f6f6ee] text-lb-gray-dark flex items-center gap-1 cursor-pointer font-number transition-colors shadow-2xs focus:outline-none focus:ring-1 focus:ring-lb-gray-dark"
          >
            <span id={`${id}-year-label`}>2026</span>
            <svg
              class="w-3 h-3 text-lb-gray opacity-60 transition-transform duration-200 shrink-0"
              id={`${id}-year-chevron`}
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>

          <!-- Year Popover Menu -->
          <div
            id={`${id}-year-popover`}
            class="hidden absolute right-0 top-full mt-1.5 w-24 max-h-56 overflow-y-auto rounded-xl border border-[#ebebdf] bg-white shadow-2xl p-1 z-[9999] font-sans font-number"
            style="background-color: #ffffff !important;"
            role="listbox"
          >
            <!-- Generated dynamically via JS -->
          </div>
        </div>
      </div>

      <!-- Next Month Button -->
      <button
        type="button"
        id={`${id}-next-month`}
        aria-label="Next month"
        class="h-8 w-8 rounded-lg border border-[#ebebdf] bg-white hover:bg-[#f6f6ee] text-lb-gray-dark flex items-center justify-center transition-colors cursor-pointer shadow-2xs shrink-0"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"
          ></path>
        </svg>
      </button>
    </div>

    <!-- Weekday Labels -->
    <div class="grid grid-cols-7 text-center mb-1.5">
      <span class="text-[11px] font-semibold text-lb-gray-light uppercase py-1"
        >Su</span
      >
      <span class="text-[11px] font-semibold text-lb-gray-light uppercase py-1"
        >Mo</span
      >
      <span class="text-[11px] font-semibold text-lb-gray-light uppercase py-1"
        >Tu</span
      >
      <span class="text-[11px] font-semibold text-lb-gray-light uppercase py-1"
        >We</span
      >
      <span class="text-[11px] font-semibold text-lb-gray-light uppercase py-1"
        >Th</span
      >
      <span class="text-[11px] font-semibold text-lb-gray-light uppercase py-1"
        >Fr</span
      >
      <span class="text-[11px] font-semibold text-lb-gray-light uppercase py-1"
        >Sa</span
      >
    </div>

    <!-- Days Grid -->
    <div id={`${id}-days-grid`} class="grid grid-cols-7 gap-1 relative z-0">
      <!-- Generated dynamically via JS -->
    </div>

    <!-- Calendar Footer (shadcn quick actions) -->
    <div
      class="mt-3 pt-2.5 border-t border-[#f0f0e6] flex items-center justify-between text-xs"
    >
      <button
        type="button"
        id={`${id}-today-btn`}
        class="text-xs font-semibold text-lb-gray hover:text-lb-gray-dark transition-colors cursor-pointer"
      >
        Today
      </button>

      <button
        type="button"
        id={`${id}-clear`}
        class="text-xs font-semibold text-rose-500 hover:text-rose-700 transition-colors cursor-pointer"
      >
        Clear
      </button>
    </div>
  </div>
</div>

<style>
  :global(.cal-day-btn) {
    display: flex;
    height: 2.25rem;
    width: 2.25rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.625rem;
    font-size: 0.8125rem;
    font-family:
      "Inter",
      system-ui,
      -apple-system,
      sans-serif;
    transition: all 0.15s ease;
    cursor: pointer;
  }

  :global(.cal-day-btn.is-disabled) {
    opacity: 0.22;
    cursor: not-allowed;
    text-decoration: line-through;
    pointer-events: none;
  }

  :global(.cal-day-btn.is-outside) {
    opacity: 0.25;
    pointer-events: none;
  }

  :global(.cal-day-btn.is-today:not(.is-selected)) {
    font-weight: 700;
    position: relative;
    background-color: #f2f2ea;
  }

  :global(.cal-day-btn.is-today:not(.is-selected)::after) {
    content: "";
    position: absolute;
    bottom: 3px;
    width: 4px;
    height: 4px;
    border-radius: 9999px;
    background-color: #2c2a2d;
  }

  :global(.cal-day-btn.is-selected) {
    background-color: #2c2a2d !important;
    color: #ffffff !important;
    font-weight: 600;
    box-shadow: 0 4px 10px rgba(44, 42, 45, 0.2);
    transform: scale(0.96);
  }

  :global(
    .cal-day-btn:not(.is-disabled):not(.is-outside):not(.is-selected):hover
  ) {
    background-color: #f0f0e6;
    color: #2c2a2d;
  }

  :global([id$="-month-popover"], [id$="-year-popover"]) {
    background-color: #ffffff !important;
    opacity: 1 !important;
    z-index: 99999 !important;
  }

  :global(.cal-month-opt[aria-selected="true"], .cal-year-opt[aria-selected="true"]) {
    background-color: #f2f2ea !important;
    font-weight: 600;
  }
  :global(.cal-month-opt[aria-selected="true"] .cal-month-check, .cal-year-opt[aria-selected="true"] .cal-year-check) {
    display: block !important;
  }
</style>

<script define:vars={{ id, placeholder }}>
  const wrapper = document.getElementById(`${id}-wrapper`);
  const trigger = document.getElementById(`${id}-trigger`);
  const popover = document.getElementById(`${id}-popover`);
  const hiddenInput = document.getElementById(`${id}-input`) || document.getElementById(id);
  const displayEl = document.getElementById(`${id}-display`);
  const chevron = document.getElementById(`${id}-chevron`);
  const prevBtn = document.getElementById(`${id}-prev-month`);
  const nextBtn = document.getElementById(`${id}-next-month`);
  const daysGrid = document.getElementById(`${id}-days-grid`);
  const todayBtn = document.getElementById(`${id}-today-btn`);
  const clearBtn = document.getElementById(`${id}-clear`);

  const monthBtn = document.getElementById(`${id}-month-btn`);
  const monthLabel = document.getElementById(`${id}-month-label`);
  const monthChevron = document.getElementById(`${id}-month-chevron`);
  const monthPopover = document.getElementById(`${id}-month-popover`);
  const monthWrapper = document.getElementById(`${id}-month-dropdown-wrapper`);
  const monthOptions = Array.from(monthPopover?.querySelectorAll(".cal-month-opt") || []);

  const yearBtn = document.getElementById(`${id}-year-btn`);
  const yearLabel = document.getElementById(`${id}-year-label`);
  const yearChevron = document.getElementById(`${id}-year-chevron`);
  const yearPopover = document.getElementById(`${id}-year-popover`);
  const yearWrapper = document.getElementById(`${id}-year-dropdown-wrapper`);

  // State
  const today = new Date();
  today.setHours(0, 0, 0, 0);

  let currentViewYear = today.getFullYear();
  let currentViewMonth = today.getMonth();
  let selectedDate = null;

  function toggleMonthPopover(show) {
    if (show) {
      toggleYearPopover(false);
      monthPopover?.classList.remove("hidden");
      monthBtn?.setAttribute("aria-expanded", "true");
      monthChevron?.classList.add("rotate-180");
    } else {
      monthPopover?.classList.add("hidden");
      monthBtn?.setAttribute("aria-expanded", "false");
      monthChevron?.classList.remove("rotate-180");
    }
  }

  function toggleYearPopover(show) {
    if (show) {
      toggleMonthPopover(false);
      yearPopover?.classList.remove("hidden");
      yearBtn?.setAttribute("aria-expanded", "true");
      yearChevron?.classList.add("rotate-180");
    } else {
      yearPopover?.classList.add("hidden");
      yearBtn?.setAttribute("aria-expanded", "false");
      yearChevron?.classList.remove("rotate-180");
    }
  }

  function initYearSelect() {
    if (!yearPopover) return;
    yearPopover.innerHTML = "";
    const startYear = today.getFullYear();
    for (let y = startYear; y <= startYear + 3; y++) {
      const opt = document.createElement("div");
      opt.className = "cal-year-opt flex items-center justify-between px-2.5 py-1.5 rounded-lg text-xs text-lb-gray-dark hover:bg-[#f6f6ee] transition-colors cursor-pointer select-none font-sans font-number";
      opt.dataset.year = y.toString();
      opt.setAttribute("role", "option");
      opt.innerHTML = `
        <span>${y}</span>
        <svg class="cal-year-check w-3 h-3 text-lb-gray-dark shrink-0 ml-1.5 hidden" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
        </svg>
      `;
      opt.addEventListener("click", (e) => {
        e.stopPropagation();
        currentViewYear = y;
        toggleYearPopover(false);
        renderCalendar();
      });
      yearPopover.appendChild(opt);
    }
  }

  function formatDate(d) {
    const options = {
      weekday: "short",
      month: "short",
      day: "numeric",
      year: "numeric",
    };
    return d.toLocaleDateString("en-US", options);
  }

  function formatISODate(d) {
    const year = d.getFullYear();
    const month = String(d.getMonth() + 1).padStart(2, "0");
    const day = String(d.getDate()).padStart(2, "0");
    return `${year}-${month}-${day}`;
  }

  function renderCalendar() {
    const monthNames = [
      "January", "February", "March", "April", "May", "June",
      "July", "August", "September", "October", "November", "December"
    ];

    if (monthLabel) {
      monthLabel.textContent = monthNames[currentViewMonth];
    }
    if (yearLabel) {
      yearLabel.textContent = currentViewYear.toString();
    }

    monthOptions.forEach((opt) => {
      const isSelected = parseInt(opt.dataset.month, 10) === currentViewMonth;
      opt.setAttribute("aria-selected", isSelected ? "true" : "false");
      const icon = opt.querySelector(".cal-month-check");
      if (icon) {
        icon.style.display = isSelected ? "block" : "none";
      }
    });

    const yearOptions = Array.from(yearPopover?.querySelectorAll(".cal-year-opt") || []);
    yearOptions.forEach((opt) => {
      const isSelected = parseInt(opt.dataset.year, 10) === currentViewYear;
      opt.setAttribute("aria-selected", isSelected ? "true" : "false");
      const icon = opt.querySelector(".cal-year-check");
      if (icon) {
        icon.style.display = isSelected ? "block" : "none";
      }
    });

    daysGrid.innerHTML = "";

    const firstDayIndex = new Date(
      currentViewYear,
      currentViewMonth,
      1,
    ).getDay();
    const daysInMonth = new Date(
      currentViewYear,
      currentViewMonth + 1,
      0,
    ).getDate();
    const daysInPrevMonth = new Date(
      currentViewYear,
      currentViewMonth,
      0,
    ).getDate();

    // Previous month padding days
    for (let i = firstDayIndex - 1; i >= 0; i--) {
      const dayNum = daysInPrevMonth - i;
      const btn = document.createElement("div");
      btn.className = "cal-day-btn is-outside";
      btn.textContent = dayNum.toString();
      daysGrid.appendChild(btn);
    }

    // Days in current month
    for (let d = 1; d <= daysInMonth; d++) {
      const dateObj = new Date(currentViewYear, currentViewMonth, d);
      dateObj.setHours(0, 0, 0, 0);

      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "cal-day-btn";
      btn.textContent = d.toString();

      if (dateObj < today) {
        btn.classList.add("is-disabled");
        btn.setAttribute("aria-disabled", "true");
      } else {
        if (dateObj.getTime() === today.getTime()) {
          btn.classList.add("is-today");
        }

        if (selectedDate && dateObj.getTime() === selectedDate.getTime()) {
          btn.classList.add("is-selected");
        }

        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          selectDate(dateObj);
        });
      }

      daysGrid.appendChild(btn);
    }
  }

  function selectDate(date) {
    selectedDate = date;
    const isoString = formatISODate(date);
    if (hiddenInput) {
      hiddenInput.value = isoString;
      hiddenInput.dispatchEvent(new Event("change", { bubbles: true }));
    }

    if (displayEl) {
      displayEl.textContent = formatDate(date);
      displayEl.classList.remove("text-lb-gray-light/80");
      displayEl.classList.add("text-lb-gray-dark", "font-medium");
    }

    renderCalendar();
    togglePopover(false);
  }

  function clearDate() {
    selectedDate = null;
    if (hiddenInput) {
      hiddenInput.value = "";
      hiddenInput.dispatchEvent(new Event("change", { bubbles: true }));
    }
    if (displayEl) {
      displayEl.textContent = placeholder;
      displayEl.classList.remove("text-lb-gray-dark", "font-medium");
      displayEl.classList.add("text-lb-gray-light/80");
    }
    renderCalendar();
  }

  function togglePopover(show) {
    if (show) {
      popover?.classList.remove("hidden");
      trigger?.setAttribute("aria-expanded", "true");
      chevron?.classList.add("rotate-180");
      renderCalendar();
    } else {
      popover?.classList.add("hidden");
      trigger?.setAttribute("aria-expanded", "false");
      chevron?.classList.remove("rotate-180");
      toggleMonthPopover(false);
      toggleYearPopover(false);
    }
  }

  // Event Listeners
  trigger?.addEventListener("click", () => {
    const isHidden = popover?.classList.contains("hidden");
    togglePopover(isHidden);
  });

  monthBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    const isHidden = monthPopover?.classList.contains("hidden");
    toggleMonthPopover(isHidden);
  });

  yearBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    const isHidden = yearPopover?.classList.contains("hidden");
    toggleYearPopover(isHidden);
  });

  monthOptions.forEach((opt) => {
    opt.addEventListener("click", (e) => {
      e.stopPropagation();
      currentViewMonth = parseInt(opt.dataset.month, 10);
      toggleMonthPopover(false);
      renderCalendar();
    });
  });

  prevBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    currentViewMonth--;
    if (currentViewMonth < 0) {
      currentViewMonth = 11;
      currentViewYear--;
    }
    renderCalendar();
  });

  nextBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    currentViewMonth++;
    if (currentViewMonth > 11) {
      currentViewMonth = 0;
      currentViewYear++;
    }
    renderCalendar();
  });

  todayBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    currentViewMonth = today.getMonth();
    currentViewYear = today.getFullYear();
    selectDate(new Date(today));
  });

  clearBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    clearDate();
    togglePopover(false);
  });

  // Close when clicking outside
  document.addEventListener("click", (e) => {
    if (!wrapper?.contains(e.target)) {
      togglePopover(false);
    } else {
      if (monthWrapper && !monthWrapper.contains(e.target)) {
        toggleMonthPopover(false);
      }
      if (yearWrapper && !yearWrapper.contains(e.target)) {
        toggleYearPopover(false);
      }
    }
  });

  // Close on Escape
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && popover && !popover.classList.contains("hidden")) {
      togglePopover(false);
    }
  });

  initYearSelect();
  renderCalendar();
</script>
