---
export interface SelectOption {
  value: string;
  label: string;
}

interface Props {
  id: string;
  name: string;
  placeholder?: string;
  options?: SelectOption[];
  defaultValue?: string;
  required?: boolean;
  class?: string;
}

const {
  id = "select",
  name = "select",
  placeholder = "Select an option...",
  options = [],
  defaultValue = "",
  required = false,
  class: className = "",
} = Astro.props;

const selectedOption = options.find((opt) => opt.value === defaultValue);
const initialDisplay = selectedOption ? selectedOption.label : placeholder;
const isInitialSelected = !!selectedOption;
---

<div class={`relative w-full custom-select ${className}`} id={`${id}-wrapper`}>
  <!-- Hidden input for standard form submission -->
  <input
    type="hidden"
    id={`${id}-input`}
    name={name}
    value={defaultValue}
    required={required}
  />

  <!-- Trigger Button (shadcn SelectTrigger) -->
  <button
    type="button"
    id={`${id}-trigger`}
    class="flex h-12 w-full items-center justify-between rounded-xl border border-[#ebebdf] bg-[#fafaf6] px-4 py-3 text-sm text-lb-gray-dark shadow-sm transition-all duration-200 hover:border-lb-gray/70 focus:bg-white focus:border-lb-gray-dark focus:outline-none focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-lb-gray-dark cursor-pointer font-sans text-left"
    aria-expanded="false"
    aria-haspopup="listbox"
  >
    <div class="flex items-center truncate max-w-[calc(100%-28px)]">
      <span
        id={`${id}-display`}
        class={`text-sm truncate select-none font-sans ${isInitialSelected ? "text-lb-gray-dark font-medium" : "text-lb-gray-light/80"}`}
      >
        {initialDisplay}
      </span>
    </div>

    <div class="flex items-center shrink-0 ml-2">
      <svg
        class="w-4 h-4 text-lb-gray opacity-50 transition-transform duration-200"
        id={`${id}-chevron`}
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"
        ></path>
      </svg>
    </div>
  </button>

  <!-- Dropdown Popover Content (shadcn SelectContent) -->
  <div
    id={`${id}-popover`}
    class="hidden absolute z-50 left-0 right-0 mt-2 w-full rounded-2xl border border-[#ebebdf] bg-white shadow-xl p-1.5 font-sans animate-fade-in"
    role="listbox"
    aria-label={placeholder}
  >
    <div class="space-y-0.5 max-h-60 overflow-y-auto">
      {
        options.map((opt) => {
          const isSelected = opt.value === defaultValue;
          return (
            <div
              class="select-option flex items-center justify-between px-3 py-2.5 rounded-xl text-xs text-lb-gray-dark hover:bg-[#f6f6ee] transition-colors cursor-pointer select-none font-sans"
              data-value={opt.value}
              data-label={opt.label}
              role="option"
              aria-selected={isSelected ? "true" : "false"}
            >
              <span class="option-label truncate font-medium">{opt.label}</span>
              <div class="flex items-center shrink-0 ml-2">
                <svg
                  class="check-icon w-3.5 h-3.5 text-lb-gray-dark shrink-0"
                  style={isSelected ? "" : "display: none;"}
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M5 13l4 4L19 7"
                  />
                </svg>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</div>

<style>
  :global(.select-option[aria-selected="true"]) {
    background-color: #f2f2ea !important;
  }
  :global(.select-option[aria-selected="true"] .option-label) {
    font-weight: 600;
  }
</style>

<script define:vars={{ id, placeholder }}>
  const wrapper = document.getElementById(`${id}-wrapper`);
  const trigger = document.getElementById(`${id}-trigger`);
  const popover = document.getElementById(`${id}-popover`);
  const hiddenInput = document.getElementById(`${id}-input`) || document.getElementById(id);
  const displayEl = document.getElementById(`${id}-display`);
  const chevron = document.getElementById(`${id}-chevron`);
  const options = Array.from(wrapper?.querySelectorAll(".select-option") || []);

  function togglePopover(show) {
    if (show) {
      popover?.classList.remove("hidden");
      trigger?.setAttribute("aria-expanded", "true");
      chevron?.classList.add("rotate-180");
    } else {
      popover?.classList.add("hidden");
      trigger?.setAttribute("aria-expanded", "false");
      chevron?.classList.remove("rotate-180");
    }
  }

  function selectOption(val, label) {
    if (hiddenInput) {
      hiddenInput.value = val;
      hiddenInput.dispatchEvent(new Event("change", { bubbles: true }));
    }

    if (displayEl) {
      displayEl.textContent = label;
      displayEl.className = "text-sm truncate select-none font-sans text-lb-gray-dark font-medium";
    }

    options.forEach((opt) => {
      const isSelected = opt.dataset.value === val;
      opt.setAttribute("aria-selected", isSelected ? "true" : "false");
      const icon = opt.querySelector(".check-icon");
      if (icon) {
        icon.style.display = isSelected ? "block" : "none";
      }
    });

    togglePopover(false);
  }

  function resetSelect() {
    if (hiddenInput) {
      hiddenInput.value = "";
    }
    if (displayEl) {
      displayEl.textContent = placeholder;
      displayEl.className = "text-sm truncate select-none font-sans text-lb-gray-light/80";
    }
    options.forEach((opt) => {
      opt.setAttribute("aria-selected", "false");
      const icon = opt.querySelector(".check-icon");
      if (icon) {
        icon.style.display = "none";
      }
    });
  }

  trigger?.addEventListener("click", (e) => {
    e.stopPropagation();
    const isHidden = popover?.classList.contains("hidden");
    togglePopover(isHidden);
  });

  options.forEach((opt) => {
    opt.addEventListener("click", (e) => {
      e.stopPropagation();
      const val = opt.dataset.value || "";
      const label = opt.dataset.label || opt.textContent.trim();
      selectOption(val, label);
      trigger?.focus();
    });
  });

  // Close when clicking outside
  document.addEventListener("click", (e) => {
    if (wrapper && !wrapper.contains(e.target)) {
      togglePopover(false);
    }
  });

  // Close on Escape
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && popover && !popover.classList.contains("hidden")) {
      togglePopover(false);
      trigger?.focus();
    }
  });

  // Reset on form reset
  const form = wrapper?.closest("form");
  form?.addEventListener("reset", () => {
    resetSelect();
  });
</script>
