---
import DefaultLayout from '../layouts/DefaultLayout.astro';
import Button from '../components/ui/Button.astro';
import { getPath } from '../utils/paths';
---

<DefaultLayout
  title="Page Not Found (404) | La Beauté Salon"
  description="The page you requested could not be found. Return to La Beauté luxury beauty salon in Manipal, Udupi."
>
  <div class="min-h-[70vh] flex items-center justify-center bg-[#f6f6ee] px-4 py-20 text-center">
    <div class="max-w-md mx-auto space-y-6">
      <div class="w-16 h-16 mx-auto rounded-full bg-[#f0f0e6] flex items-center justify-center text-lb-gray-dark font-serif font-bold text-2xl border border-[#ebebdf]">
        LB
      </div>

      <span class="text-xs uppercase tracking-[0.2em] text-lb-gray font-semibold block font-sans">
        Error 404
      </span>

      <h1 class="font-serif text-4xl sm:text-5xl font-bold text-lb-gray-dark">
        Page Not Found
      </h1>

      <p class="text-sm text-lb-gray font-light leading-relaxed">
        The sanctuary you are looking for might have been relocated or renamed. Please return to our main salon directory.
      </p>

      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button
          href={getPath("/")}
          variant="default"
          size="default"
          class="w-full sm:w-auto"
        >
          Return to Home
        </Button>
        <Button
          href={getPath("/services")}
          variant="outline"
          size="default"
          class="w-full sm:w-auto"
        >
          View Services
        </Button>
      </div>
    </div>
  </div>
</DefaultLayout>
