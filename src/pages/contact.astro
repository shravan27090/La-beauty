---
import DefaultLayout from '../layouts/DefaultLayout.astro';
import ContactForm from '../components/ContactForm.astro';
---

<DefaultLayout
  title="Contact Us & Salon Location | La Beauté Manipal, Udupi"
  description="Book your beauty appointment or visit La Beauté salon at Greenview Apartments, SH 65, near Trends, Manipal. Phone: +91 720 410 3767, open daily 10 AM to 8 PM."
>
  <!-- HERO HEADER -->
  <section class="py-16 sm:py-20 bg-[#f6f6ee] border-b border-[#ebebdf]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-xs uppercase tracking-[0.2em] text-lb-gray font-semibold font-sans">Connect With Us</span>
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-extrabold text-lb-gray-dark mt-3 mb-6">
        Visit Our Salon Suite
      </h1>
      <p class="text-base sm:text-lg text-lb-gray max-w-2xl mx-auto font-light leading-relaxed">
        Located centrally at Greenview Apartments in Manipal. Walk-ins welcome based on therapist availability; prior reservations recommended.
      </p>
    </div>
  </section>

  <!-- CONTACT & LOCATION SECTION -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Left: Quick Contact Info & Map -->
        <div class="lg:col-span-5 space-y-8">
          
          <!-- Contact Detail Cards -->
          <div class="space-y-4">
            <!-- Phone / WhatsApp -->
            <div class="p-6 rounded-3xl bg-[#fafaf6] border border-[#ebebdf] flex items-start space-x-4">
              <div class="w-12 h-12 rounded-2xl bg-[#f0f0e6] text-lb-gray-dark flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z"></path>
                </svg>
              </div>
              <div>
                <span class="text-xs uppercase tracking-wider font-semibold text-lb-gray-light block mb-1 font-sans">
                  Phone & WhatsApp
                </span>
                <a href="tel:+917204103767" class="font-number text-xl font-bold text-lb-gray-dark hover:text-black transition-colors block">
                  +91 720 410 3767
                </a>
                <p class="text-xs text-lb-gray mt-1 font-number">Available daily 10:00 AM – 8:00 PM</p>
              </div>
            </div>

            <!-- Email -->
            <div class="p-6 rounded-3xl bg-[#fafaf6] border border-[#ebebdf] flex items-start space-x-4">
              <div class="w-12 h-12 rounded-2xl bg-[#f0f0e6] text-lb-gray-dark flex items-center justify-center flex-shrink-0">
                <svg class="w-2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path>
                  <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
                </svg>
              </div>
              <div>
                <span class="text-xs uppercase tracking-wider font-semibold text-lb-gray-light block mb-1 font-sans">
                  Email Address
                </span>
                <a href="mailto:info@la-beaute.in" class="font-sans text-base font-bold text-lb-gray-dark hover:text-black transition-colors block">
                  info@la-beaute.in
                </a>
                <p class="text-xs text-lb-gray mt-1">For event suites & bridal inquiries</p>
              </div>
            </div>

            <!-- Exact Address & Parking -->
            <div class="p-6 rounded-3xl bg-[#fafaf6] border border-[#ebebdf] flex items-start space-x-4">
              <div class="w-12 h-12 rounded-2xl bg-[#f0f0e6] text-lb-gray-dark flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <span class="text-xs uppercase tracking-wider font-semibold text-lb-gray-light block mb-1 font-sans">
                  Exact Salon Location
                </span>
                <p class="font-sans text-sm font-semibold text-lb-gray-dark leading-relaxed">
                  Greenview Apartments, SH 65, near Trends, Manipal, Hayagreeva Nagar, Udupi, Karnataka 576104
                </p>
                <p class="text-xs text-lb-gray mt-1 font-sans">Ample dedicated client parking available</p>
              </div>
            </div>
          </div>

          <!-- Google Maps Embed with Eager Loading (Above-the-fold) and Exact Plus Code Pin -->
          <div class="rounded-3xl overflow-hidden border border-[#ebebdf] shadow-sm h-72 relative group">
            <a
              href="https://www.google.com/maps/search/?api=1&query=8QXJ%2BMJ+Hayagreeva+Nagar%2C+Udupi%2C+Karnataka"
              target="_blank"
              rel="noopener noreferrer"
              class="absolute top-3 left-3 z-10 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/95 hover:bg-white text-xs font-semibold text-lb-gray-dark shadow-md border border-[#ebebdf] backdrop-blur-xs transition-all hover:scale-102 cursor-pointer"
            >
              <span>Open in Maps</span>
              <svg class="w-3.5 h-3.5 text-lb-gray" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
            <iframe
              title="La Beauté Location Map"
              width="100%"
              height="100%"
              style="border:0;"
              loading="eager"
              allowfullscreen=""
              referrerpolicy="no-referrer-when-downgrade"
              src="https://maps.google.com/maps?q=8QXJ%2BMJ%2C+Hayagreeva+Nagar%2C+Udupi%2C+Karnataka&t=&z=16&ie=UTF8&iwloc=&output=embed"
            ></iframe>
          </div>

        </div>

        <!-- Right: Interactive Contact Form with Shadcn UI Components -->
        <div class="lg:col-span-7">
          <ContactForm />
        </div>

      </div>
    </div>
  </section>
</DefaultLayout>
