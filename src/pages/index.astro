---
import DefaultLayout from "../layouts/DefaultLayout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import ImageGallery from "../components/ImageGallery.astro";
import ReviewsMarquee from "../components/ReviewsMarquee.astro";
import Button from "../components/ui/Button.astro";

const featuredServices = [
  {
    title: "Russian Precision Manicure",
    category: "Nail Lounge",
    price: "₹950",
    duration: "50 mins",
    popular: true,
    description:
      "Waterless dry cuticle detailing utilizing sterile European diamond e-file bits under magnification. Gently clears stubborn periungual dead skin without scissors, preparing the nail plate for flawless deep-color adhesion with immaculate regrowth lasting 3 to 4 weeks.",
    image: "/classic-manicure-extractpics.webp",
  },
  {
    title: "Bespoke Gel & Chrome Nail Art",
    category: "Nail Art",
    price: "₹1,450",
    duration: "60 mins",
    popular: true,
    description:
      "Haute couture custom nail artistry featuring micro French smile lines, iridescent glazed donut chrome veil, Cat-Eye magnetic velvet shimmer, or bespoke hand-painted botanical motifs tailored precisely to your aesthetic.",
    image: "/nail-services-extractpics.webp",
  },
  {
    title: "Deluxe Volcanic Foot Spa Pedicure",
    category: "Pedicure",
    price: "₹1,350",
    duration: "65 mins",
    popular: false,
    description:
      "A therapeutic 6-step holistic ritual commencing with warm Mediterranean eucalyptus foot soak, volcanic pumice smoothing, raw sugar cane exfoliation, deep callus repair balm, and a restorative 20-minute acupressure massage.",
    image: "/pedicure-extractpics.webp",
  },
  {
    title: "Pain-Free Cooling Laser Hair Reduction",
    category: "Laser Clinic",
    price: "₹1,800",
    duration: "30 mins",
    popular: true,
    description:
      "Cutting-edge triple wavelength diode laser featuring continuous -5°C sapphire crystal contact cooling that eliminates thermal discomfort. Highly effective, virtually painless, and clinically safe across all Indian Fitzpatrick skin tones.",
    image: "/laser-hair-reduction-extractpics.webp",
  },
  {
    title: "Parisian Radiance Enzyme Glow Facial",
    category: "Skincare",
    price: "₹2,400",
    duration: "60 mins",
    popular: false,
    description:
      "European facial sculpting massage paired with organic papaya and fermented pumpkin enzyme resurfacing, multi-layer hyaluronic hydro-infusion, and a restorative spirulina marine alginate mask for instant glass-skin luminosity.",
    image: "/facial-extractpics.webp",
  },
  {
    title: "Silk Honey Waxing & Brow Architecture",
    category: "Waxing & Brows",
    price: "₹650",
    duration: "35 mins",
    popular: false,
    description:
      "Hypoallergenic Italian stripless golden honey wax formulated specifically for sensitive skin, accompanied by bespoke geometric Golden Ratio eyebrow mapping, artisan tweezing, and soothing organic aloe vera mist.",
    image:
      "https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?auto=format&fit=crop&w=800&q=80",
  },
];
---

<DefaultLayout>
  <!-- HERO SECTION -->
  <section
    class="relative min-h-[90vh] flex items-center justify-center bg-[#f6f6ee] overflow-hidden pt-8 pb-16"
  >
    <!-- Ambient subtle background decorative circles -->
    <div
      class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-[#ebebdf]/60 filter blur-3xl pointer-events-none"
    >
    </div>
    <div
      class="absolute -bottom-24 -left-24 w-96 h-96 rounded-full bg-[#f0f0e6]/70 filter blur-3xl pointer-events-none"
    >
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
      <div
        class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center"
      >
        <!-- Left Hero Text -->
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
          <!-- Main Serif Headline -->
          <h1
            class="font-serif text-4xl sm:text-5xl lg:text-6xl font-extrabold text-lb-gray-dark leading-[1.15] tracking-tight"
          >
            Where Beauty <br />
            <span class="italic font-normal text-lb-gray">Meets Art.</span>
          </h1>

          <!-- Body Description -->
          <p
            class="text-base sm:text-lg text-lb-gray max-w-2xl mx-auto lg:mx-0 font-light leading-relaxed"
          >
            Experience Parisian understated elegance in Manipal. We specialize
            in precision Russian cuticles, architectural nail art, painless
            laser hair reduction, and rejuvenating clinical skincare.
          </p>

          <!-- CTAs using Button component (no bg-lb-accent) -->
          <div
            class="pt-4 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4"
          >
            <!-- Primary Action -->
            <Button
              href="/contact"
              target="_blank"
              rel="noopener noreferrer"
              variant="default"
              size="lg"
              class="w-full sm:w-auto"
            >
              <span>Book Appointment</span>
              <svg
                class="w-3.5 h-3.5 ml-2"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
                  clip-rule="evenodd"></path>
              </svg>
            </Button>

            <!-- Secondary Outline Action -->
            <Button
              href="/services"
              variant="outline"
              size="lg"
              class="w-full sm:w-auto"
            >
              Explore Services
            </Button>
          </div>

          <!-- Rating & Social Trust Strip with Inter numbers -->
          <div
            class="pt-6 border-t border-[#ebebdf] flex flex-wrap items-center justify-center lg:justify-start gap-6 text-xs text-lb-gray font-number"
          >
            <div class="flex items-center space-x-2">
              <div class="flex text-amber-400 text-sm">
                <span>★</span><span>★</span><span>★</span><span>★</span><span
                  >★</span
                >
              </div>
              <span class="font-bold text-lb-gray-dark">4.9 / 5</span>
              <span>(23 Google Reviews)</span>
            </div>
            <span class="hidden sm:inline text-gray-300">&bull;</span>
            <div class="flex items-center space-x-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span class="font-medium text-lb-gray-dark"
                >Open Daily: 10:00 AM – 8:00 PM</span
              >
            </div>
          </div>
        </div>

        <!-- Right Hero Visual Grid -->
        <div class="lg:col-span-5 relative">
          <div class="relative mx-auto max-w-md lg:max-w-none">
            <!-- Main Hero Image Frame -->
            <div
              class="relative rounded-3xl overflow-hidden shadow-2xl border-4 border-white aspect-[4/5] bg-white"
            >
              <img
                src="/nail-services-extractpics.webp"
                alt="Luxury Nail Art at La Beauté"
                class="w-full h-full object-cover"
                loading="eager"
              />
              <div
                class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"
              >
              </div>
              <div class="absolute bottom-6 left-6 right-6 text-white">
                <span
                  class="text-[10px] uppercase tracking-widest text-gray-300 font-semibold block mb-1 font-sans"
                >
                  Signature Craftsmanship
                </span>
                <p class="font-serif text-xl font-bold">
                  Russian Dry Cuticle Precision & French Chrome
                </p>
              </div>
            </div>

            <!-- Floating Credibility Badge 1 -->
            <div
              class="absolute -top-6 -left-6 bg-white/95 backdrop-blur-md p-4 rounded-2xl border border-[#ebebdf] shadow-luxury hidden sm:flex items-center space-x-3"
            >
              <div
                class="w-10 h-10 rounded-full bg-[#f0f0e6] flex items-center justify-center text-lb-gray-dark font-number font-bold text-base"
              >
                10+
              </div>
              <div>
                <p class="text-xs font-bold text-lb-gray-dark font-sans">
                  Years Expertise
                </p>
                <p class="text-[10px] text-lb-gray-light font-sans">
                  UAE Trained Masters
                </p>
              </div>
            </div>

            <!-- Floating Credibility Badge 2 -->
            <div
              class="absolute -bottom-6 -right-6 bg-white/95 backdrop-blur-md p-4 rounded-2xl border border-[#ebebdf] shadow-luxury hidden sm:flex items-center space-x-3"
            >
              <div
                class="w-10 h-10 rounded-full bg-emerald-50 flex items-center justify-center text-emerald-600 font-bold"
              >
                ✓
              </div>
              <div>
                <p class="text-xs font-bold text-lb-gray-dark font-sans">
                  100% Autoclaved
                </p>
                <p class="text-[10px] text-lb-gray-light font-sans">
                  Hospital-Grade Sterile
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CREDIBILITY STATS STRIP with Inter numbers -->
  <section class="py-12 bg-white border-y border-[#ebebdf]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div
        class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center font-number"
      >
        <div class="reveal-on-scroll">
          <p class="text-3xl sm:text-4xl font-extrabold text-lb-gray-dark mb-1">
            4.9★
          </p>
          <p class="text-xs uppercase tracking-wider text-lb-gray font-sans">
            23 Google Reviews
          </p>
        </div>
        <div class="reveal-on-scroll">
          <p class="text-3xl sm:text-4xl font-extrabold text-lb-gray-dark mb-1">
            10+ Yrs
          </p>
          <p class="text-xs uppercase tracking-wider text-lb-gray font-sans">
            UAE Salon Expertise
          </p>
        </div>
        <div class="reveal-on-scroll">
          <p class="text-3xl sm:text-4xl font-extrabold text-lb-gray-dark mb-1">
            100%
          </p>
          <p class="text-xs uppercase tracking-wider text-lb-gray font-sans">
            Sterile Autoclaved Kits
          </p>
        </div>
        <div class="reveal-on-scroll">
          <p class="text-3xl sm:text-4xl font-extrabold text-lb-gray-dark mb-1">
            1 Year
          </p>
          <p class="text-xs uppercase tracking-wider text-lb-gray font-sans">
            Celebrating in Manipal
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES GRID SECTION (Enhanced Grid Format) -->
  <section class="py-24 bg-[#f6f6ee]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto mb-16 reveal-on-scroll">
        <span
          class="text-xs uppercase tracking-[0.2em] text-lb-gray font-semibold font-sans"
          >Curated Treatments</span
        >
        <h2
          class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-lb-gray-dark mt-2 mb-4"
        >
          Signature Salon Services
        </h2>
        <p class="text-base text-lb-gray font-light">
          Each treatment is tailored to your unique aesthetic preferences,
          utilizing exclusively imported European hypoallergenic formulations.
        </p>
      </div>

      <!-- Enhanced Responsive Grid: 3 cols on desktop, 2 cols on tablet, 1 col on mobile -->
      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch"
      >
        {
          featuredServices.map((service) => (
            <div class="reveal-on-scroll h-full">
              <ServiceCard {...service} />
            </div>
          ))
        }
      </div>

      <div class="mt-14 text-center">
        <Button href="/services" variant="outline" size="lg">
          <span>Explore Complete Services & Add-Ons</span>
          <svg
            class="w-4 h-4 ml-2"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </Button>
      </div>
    </div>
  </section>

  <!-- WHY US SECTION with user provided why-us image and exact address -->
  <section class="py-24 bg-white border-y border-[#ebebdf] overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div
        class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center"
      >
        <!-- Left Image Composition -->
        <div class="lg:col-span-6 relative reveal-on-scroll">
          <div
            class="relative rounded-3xl overflow-hidden shadow-2xl border-4 border-[#f6f6ee]"
          >
            <img
              src="/why-us-1-e1743867652246-extractpics.webp"
              alt="La Beauté Salon in Manipal"
              width="700"
              height="813"
              class="w-full h-[450px] aspect-[700/813] object-cover"
              loading="lazy"
              decoding="async"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"
            >
            </div>
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <p class="font-serif text-2xl font-bold">The Parisian Standard</p>
              <p class="text-xs text-gray-300 font-sans mt-1">
                Greenview Apartments, SH 65, near Trends, Manipal
              </p>
            </div>
          </div>
        </div>

        <!-- Right Story & 4 Pillars -->
        <div class="lg:col-span-6 space-y-8 reveal-on-scroll">
          <div>
            <span
              class="text-xs uppercase tracking-[0.2em] text-lb-gray font-semibold font-sans"
              >Uncompromising Quality</span
            >
            <h2
              class="font-serif text-3xl sm:text-4xl font-bold text-lb-gray-dark mt-2 mb-4"
            >
              Why Discerning Clients Choose La Beauté
            </h2>
            <p
              class="text-sm sm:text-base text-lb-gray font-light leading-relaxed"
            >
              Founded after a decade of directing luxury salon suites in the
              UAE, La Beauté was built on a simple conviction: beauty treatments
              should be unhurried, hygienic, and elevated into fine art.
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <!-- Pillar 1 -->
            <div class="p-5 rounded-2xl bg-[#fafaf6] border border-[#ebebdf]">
              <div
                class="w-10 h-10 rounded-xl bg-[#f0f0e6] text-lb-gray-dark flex items-center justify-center font-number font-bold text-base mb-3"
              >
                01
              </div>
              <h3 class="font-serif font-bold text-base text-lb-gray-dark mb-1">
                UAE Master Stylists
              </h3>
              <p class="text-xs text-lb-gray font-light leading-relaxed">
                10+ years international background bringing advanced Russian dry
                manicure & European skin protocols.
              </p>
            </div>

            <!-- Pillar 2 -->
            <div class="p-5 rounded-2xl bg-[#fafaf6] border border-[#ebebdf]">
              <div
                class="w-10 h-10 rounded-xl bg-[#f0f0e6] text-lb-gray-dark flex items-center justify-center font-number font-bold text-base mb-3"
              >
                02
              </div>
              <h3 class="font-serif font-bold text-base text-lb-gray-dark mb-1">
                Hospital-Grade Sterile
              </h3>
              <p class="text-xs text-lb-gray font-light leading-relaxed">
                Autoclaved metallic instruments sealed in sterile pouches opened
                only in front of each client.
              </p>
            </div>

            <!-- Pillar 3 -->
            <div class="p-5 rounded-2xl bg-[#fafaf6] border border-[#ebebdf]">
              <div
                class="w-10 h-10 rounded-xl bg-[#f0f0e6] text-lb-gray-dark flex items-center justify-center font-number font-bold text-base mb-3"
              >
                03
              </div>
              <h3 class="font-serif font-bold text-base text-lb-gray-dark mb-1">
                Clean & Vegan Formulas
              </h3>
              <p class="text-xs text-lb-gray font-light leading-relaxed">
                9-free, non-toxic gel polishes and cruelty-free dermo-cosmetics
                that protect your natural nail bed.
              </p>
            </div>

            <!-- Pillar 4 -->
            <div class="p-5 rounded-2xl bg-[#fafaf6] border border-[#ebebdf]">
              <div
                class="w-10 h-10 rounded-xl bg-[#f0f0e6] text-lb-gray-dark flex items-center justify-center font-number font-bold text-base mb-3"
              >
                04
              </div>
              <h3 class="font-serif font-bold text-base text-lb-gray-dark mb-1">
                Transparent Pricing
              </h3>
              <p class="text-xs text-lb-gray font-light leading-relaxed">
                Honest upfront pricing with no hidden upsells. Luxury aesthetics
                accessible right here in Udupi.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PORTFOLIO PREVIEW SECTION -->
  <section class="py-24 bg-[#f6f6ee] border-t border-[#ebebdf]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div
        class="flex flex-col md:flex-row md:items-end justify-between mb-12 reveal-on-scroll"
      >
        <div>
          <span
            class="text-xs uppercase tracking-[0.2em] text-lb-gray font-semibold font-sans"
            >Artisan Showcase</span
          >
          <h2
            class="font-serif text-3xl sm:text-4xl font-bold text-lb-gray-dark mt-2"
          >
            See Our Recent Works
          </h2>
        </div>
        <a
          href="/portfolio"
          class="mt-4 md:mt-0 inline-flex items-center space-x-2 text-xs uppercase tracking-wider font-semibold text-lb-gray hover:text-black transition-colors"
        >
          <span>Open Full Gallery & Lightbox</span>
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>

      <div class="reveal-on-scroll">
        <ImageGallery limit={4} showFilters={false} />
      </div>
    </div>
  </section>

  <!-- CLIENT REVIEWS SECTION: Animated & Horizontally Scrollable Marquee -->
  <section class="py-24 bg-white border-t border-[#ebebdf]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12 reveal-on-scroll">
        <span
          class="text-xs uppercase tracking-[0.2em] text-lb-gray font-semibold font-sans"
          >Client Reviews</span
        >
        <h2
          class="font-serif text-3xl sm:text-4xl font-bold text-lb-gray-dark mt-2 mb-4"
        >
          What Our Clients Say
        </h2>
        <p class="text-sm sm:text-base text-lb-gray font-light">
          Real verified experiences from clients across Udupi & Manipal who
          trust La Beauté for precision aesthetics.
        </p>
      </div>

      <div class="reveal-on-scroll">
        <ReviewsMarquee />
      </div>
    </div>
  </section>
</DefaultLayout>
